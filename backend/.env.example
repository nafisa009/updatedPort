# Copy this file to .env and fill in your real values

# Get this from https://console.anthropic.com/ -> Settings -> API Keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated list of allowed frontend origins (e.g. your GitHub Pages URL)
# Use "*" during local testing, restrict it once deployed
ALLOWED_ORIGINS=*

# Port the server listens on (Render/Railway set this automatically)
PORT=5000
